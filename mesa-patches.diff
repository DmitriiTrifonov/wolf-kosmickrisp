+           f * 1e9 / (now - last), frame_ms,
+           (double)n[KK_PERF_DRAW] / f, n[KK_PERF_DRAW] ? ns[KK_PERF_DRAW] / 1e3 / n[KK_PERF_DRAW] : 0.0,
+           ns[KK_PERF_DRAW] / 1e6 / f,
