+#include <stdatomic.h>
+#include <stdio.h>
+static _Atomic uint64_t kk_perf_ns[KK_PERF_COUNT], kk_perf_n[KK_PERF_COUNT];
+static _Atomic uint64_t kk_perf_frames, kk_perf_last;
+
+void
+kk_perf_add(int slot, uint64_t t0)
+{
+   kk_perf_ns[slot] += kk_perf_now() - t0;
+   kk_perf_n[slot]++;
+}
+
+void
+kk_perf_add_ns(int slot, uint64_t ns)
+{
+   kk_perf_ns[slot] += ns;
+   kk_perf_n[slot]++;
+}
+
+void kk_perf_frame(void);
+void
+kk_perf_frame(void)
+{
+   uint64_t now = kk_perf_now();
+   uint64_t last = kk_perf_last;
+   kk_perf_frames++;
+   if (last == 0) {
+      kk_perf_last = now;
+      return;
+   }
+   if (now - last < 2000000000ull ||
+       !atomic_compare_exchange_strong(&kk_perf_last, &last, now))
+      return;
+   uint64_t f = atomic_exchange(&kk_perf_frames, 0);
+   uint64_t ns[KK_PERF_COUNT], n[KK_PERF_COUNT];
+   for (int i = 0; i < KK_PERF_COUNT; i++) {
+      ns[i] = atomic_exchange(&kk_perf_ns[i], 0);
+      n[i] = atomic_exchange(&kk_perf_n[i], 0);
+   }
+   if (!f)
+      return;
+   double frame_ms = (now - last) / 1e6 / f;
+   fprintf(stderr,
+           "kkperf: fps=%.1f frame=%.1fms | draws/f=%.0f %.1fus/draw kk_draw=%.1fms/f | "
+           "disp/f=%.0f kk_disp=%.1fms/f | submits/f=%.1f kk_submit=%.1fms/f | acquire=%.1fms/f | "
+           "gpu=%.1fms/f (%.1f cb/f) | sync_wait=%.1fms/f (%.1f/f) | query_wait=%.1fms/f (%.1f/f)\n",
+           f * 1e9 / (now - last), frame_ms,
+           (double)n[KK_PERF_DRAW] / f, n[KK_PERF_DRAW] ? ns[KK_PERF_DRAW] / 1e3 / n[KK_PERF_DRAW] : 0.0,
+           ns[KK_PERF_DRAW] / 1e6 / f,
+           (double)n[KK_PERF_DISPATCH] / f, ns[KK_PERF_DISPATCH] / 1e6 / f,
+           (double)n[KK_PERF_SUBMIT] / f, ns[KK_PERF_SUBMIT] / 1e6 / f,
+           ns[KK_PERF_ACQUIRE] / 1e6 / f,
+           ns[KK_PERF_GPU] / 1e6 / f, (double)n[KK_PERF_GPU] / f,
+           ns[KK_PERF_SYNC_WAIT] / 1e6 / f, (double)n[KK_PERF_SYNC_WAIT] / f,
+           ns[KK_PERF_QUERY_WAIT] / 1e6 / f, (double)n[KK_PERF_QUERY_WAIT] / f);
+}
