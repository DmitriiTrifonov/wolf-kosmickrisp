+   uint64_t last = kk_perf_last;
+   kk_perf_frames++;
+   if (last == 0) {
+      kk_perf_last = now;
+      return;
+   }
+   if (now - last < 2000000000ull ||
+       !atomic_compare_exchange_strong(&kk_perf_last, &last, now))
+      return;
+   uint64_t f = atomic_exchange(&kk_perf_frames, 0);
+   uint64_t ns[KK_PERF_COUNT], n[KK_PERF_COUNT];
+   for (int i = 0; i < KK_PERF_COUNT; i++) {
+      ns[i] = atomic_exchange(&kk_perf_ns[i], 0);
+      n[i] = atomic_exchange(&kk_perf_n[i], 0);
+   }
+   if (!f)
+      return;
+   char pc[256] = "";
+   for (int i = 0, o = 0; i < 64; i++) {
+      uint64_t c = atomic_exchange(&kk_perf_precomp_n[i], 0);
+      if (c >= f && o < (int)sizeof(pc) - 24)
+         o += snprintf(pc + o, sizeof(pc) - o, " p%d=%.1f", i, (double)c / f);
+   }
+   fprintf(stderr, "kkperf2: render_enc/f=%.1f compute_enc/f=%.1f barrier_splits/f=%.1f precomp/f=%.1f%s | "
+           "rp_begin=%.1fms/f (%.1f/f) barrier=%.1fms/f (%.1f/f) rp_end=%.1fms/f cs_end=%.1fms/f (%.1f/f) "
+           "end_cmdbuf=%.1fms/f (%.1f/f) clear=%.1fms/f (%.1f/f) new_rpd=%.1fms/f start_render=%.1fms/f (%.1f/f) new_cb=%.1fms/f new_renc=%.1fms/f (%.1f/f) renc_grow=%.1fms/f (%.1f/f) alloc_trims/f=%.2f alloc_growth=%.1fMB/f (%.1f resets/f)\n",
+           (double)n[KK_PERF_RENDER_ENC] / f, (double)n[KK_PERF_COMPUTE_ENC] / f,
+           (double)n[KK_PERF_BARRIER_SPLIT] / f, (double)n[KK_PERF_PRECOMP] / f, pc,
+           ns[KK_PERF_RENDERING] / 1e6 / f, (double)n[KK_PERF_RENDERING] / f,
+           ns[KK_PERF_BARRIER] / 1e6 / f, (double)n[KK_PERF_BARRIER] / f,
+           ns[KK_PERF_RP_END] / 1e6 / f, ns[KK_PERF_CS_END] / 1e6 / f,
+           (double)n[KK_PERF_CS_END] / f, ns[KK_PERF_END_CMDBUF] / 1e6 / f,
+           (double)n[KK_PERF_END_CMDBUF] / f, ns[KK_PERF_CLEAR] / 1e6 / f,
+           (double)n[KK_PERF_CLEAR] / f, ns[KK_PERF_NEW_RPD] / 1e6 / f,
+           ns[KK_PERF_START_RENDER] / 1e6 / f, (double)n[KK_PERF_START_RENDER] / f,
+           ns[KK_PERF_NEW_CB] / 1e6 / f, ns[KK_PERF_NEW_RENC] / 1e6 / f,
+           (double)n[KK_PERF_NEW_RENC] / f, ns[KK_PERF_RENC_GROW] / 1e6 / f,
+           (double)n[KK_PERF_RENC_GROW] / f, (double)n[KK_PERF_ALLOC_TRIM] / f,
+           ns[KK_PERF_ALLOC_GROWTH] / 1048576.0 / f, (double)n[KK_PERF_ALLOC_GROWTH] / f);
+   double frame_ms = (now - last) / 1e6 / f;
+   fprintf(stderr,
