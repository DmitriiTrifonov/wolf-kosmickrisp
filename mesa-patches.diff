+#include <stdatomic.h>
+#include <stdio.h>
+static _Atomic uint64_t kk_perf_ns[KK_PERF_COUNT], kk_perf_n[KK_PERF_COUNT];
+static _Atomic uint64_t kk_perf_frames, kk_perf_last;
+
+void
+kk_perf_add(int slot, uint64_t t0)
+{
+   kk_perf_ns[slot] += kk_perf_now() - t0;
+   kk_perf_n[slot]++;
+}
+
+void
+kk_perf_add_ns(int slot, uint64_t ns)
+{
+   kk_perf_ns[slot] += ns;
+   kk_perf_n[slot]++;
+}
+
+static _Atomic uint64_t kk_perf_precomp_n[64];
+void
+kk_perf_precomp(unsigned idx)
+{
+   kk_perf_n[KK_PERF_PRECOMP]++;
+   kk_perf_precomp_n[idx & 63]++;
+}
