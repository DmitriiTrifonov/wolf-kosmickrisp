+
+static void
+zink_wait_account(const char *site, uint64_t ns)
+{
+   simple_mtx_lock(&zink_wait_mtx);
+   unsigned i;
+   for (i = 0; i < ARRAY_SIZE(zink_wait_stats); i++) {
+      if (!zink_wait_stats[i].site)
+         zink_wait_stats[i].site = site;
+      if (zink_wait_stats[i].site == site)
+         break;
+   }
+   if (i < ARRAY_SIZE(zink_wait_stats)) {
+      zink_wait_stats[i].ns += ns;
+      zink_wait_stats[i].n++;
+   }
+   uint64_t now = os_time_get_nano();
+   if (!zink_wait_last)
+      zink_wait_last = now;
+   if (now - zink_wait_last > 2000000000ull) {
+      double secs = (now - zink_wait_last) / 1e9;
+      char buf[1024];
+      int o = 0;
+      for (i = 0; i < ARRAY_SIZE(zink_wait_stats) && zink_wait_stats[i].site; i++) {
+         if (zink_wait_stats[i].n && o < (int)sizeof(buf) - 80) {
+            const char *s = strrchr(zink_wait_stats[i].site, '/');
+            o += snprintf(buf + o, sizeof(buf) - o, " %s=%.1fms/s(%.0f/s)", s ? s + 1 : zink_wait_stats[i].site,
+                          zink_wait_stats[i].ns / 1e6 / secs, zink_wait_stats[i].n / secs);
+         }
+         zink_wait_stats[i].ns = zink_wait_stats[i].n = 0;
+      }
+      fprintf(stderr, "zinkwait:%s | last: %s\n", buf, zink_wait_info);
+      zink_wait_last = now;
+   }
+   simple_mtx_unlock(&zink_wait_mtx);
+}
