+/* TEMP diagnostics: capture one frame to a .gputrace when /tmp/kkcapture
+ * appears. Needs MTL_CAPTURE_ENABLED=1 in the environment. Called once per
+ * frame (at swapchain acquire), so a capture spans exactly one frame. */
+#include <Metal/MTLCaptureManager.h>
+#include <objc/objc-exception.h>
+static objc_exception_preprocessor kk_prev_exc_pp;
+static id
+kk_exc_pp(id exc)
+{
+   NSException *e = (NSException *)exc;
+   fprintf(stderr, "kkcapture: objc exception %s: %s\n%s\n",
+           [[e name] UTF8String], [[e reason] UTF8String],
+           [[[e callStackSymbols] componentsJoinedByString:@"\n"] UTF8String]);
+   return kk_prev_exc_pp ? kk_prev_exc_pp(exc) : exc;
+}
+#include <sys/stat.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+void kk_capture_frame_tick(void);
+void
+kk_capture_frame_tick(void)
+{
+   static bool capturing;
+   @autoreleasepool {
+      MTLCaptureManager *mgr = [MTLCaptureManager sharedCaptureManager];
+      if (capturing) {
+         [mgr stopCapture];
+         capturing = false;
+         fprintf(stderr, "kkcapture: stopped\n");
+         return;
+      }
+      struct stat st;
+      if (stat("/tmp/kkcapture", &st) != 0)
+         return;
+      unlink("/tmp/kkcapture");
+      static bool pp_set;
+      if (!pp_set) {
+         kk_prev_exc_pp = objc_setExceptionPreprocessor(kk_exc_pp);
+         pp_set = true;
+      }
+      if (![mgr supportsDestination:MTLCaptureDestinationGPUTraceDocument]) {
+         fprintf(stderr, "kkcapture: gputrace destination unsupported (MTL_CAPTURE_ENABLED=1?)\n");
+         return;
+      }
+      char path[512];
+      snprintf(path, sizeof(path), "%s/Desktop/kk-%ld.gputrace", getenv("HOME"), (long)time(NULL));
+      MTLCaptureDescriptor *desc = [[MTLCaptureDescriptor new] autorelease];
+      desc.captureObject = MTLCreateSystemDefaultDevice();
+      desc.destination = MTLCaptureDestinationGPUTraceDocument;
+      desc.outputURL = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path]];
+      NSError *err = nil;
+      if ([mgr startCaptureWithDescriptor:desc error:&err]) {
+         capturing = true;
+         fprintf(stderr, "kkcapture: started %s\n", path);
+      } else {
+         fprintf(stderr, "kkcapture: start failed: %s\n", [[err localizedDescription] UTF8String]);
+      }
+   }
+}
