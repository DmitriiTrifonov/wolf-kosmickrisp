+/* TEMP diagnostics: total memory held by MTL4 command allocators */
+#include <pthread.h>
+#include <stdio.h>
+#define KA_CAP 16384
+static pthread_mutex_t ka_mtx = PTHREAD_MUTEX_INITIALIZER;
+static struct { void *p; uint64_t size; } ka[KA_CAP];
+static uint64_t ka_sum, ka_max;
+static long ka_n, ka_resets;
+void kk_alloc_note(void *p, uint64_t size);
+void kk_alloc_note(void *p, uint64_t size)
+{
+   pthread_mutex_lock(&ka_mtx);
+   uint32_t h = (uint32_t)(((uintptr_t)p >> 4) * 2654435761u) & (KA_CAP - 1);
+   for (int n = 0; n < KA_CAP && ka[h].p && ka[h].p != p; n++)
+      h = (h + 1) & (KA_CAP - 1);
+   if (!ka[h].p) { ka[h].p = p; ka_n++; }
+   ka_sum += size - ka[h].size;
+   ka[h].size = size;
+   if (size > ka_max) ka_max = size;
+   if ((++ka_resets % 20000) == 0)
+      fprintf(stderr, "kkalloc: allocators=%ld sum=%lluMB max=%lluKB\n", ka_n,
+              (unsigned long long)(ka_sum >> 20), (unsigned long long)(ka_max >> 10));
+   pthread_mutex_unlock(&ka_mtx);
+}
