+   while (i > 0 && dev->bo_index.bos[i - 1] != bo &&
+          dev->bo_index.bos[i - 1]->gpu == bo->gpu)
+      i--;
+   if (i > 0 && dev->bo_index.bos[i - 1] == bo) {
+      memmove(&dev->bo_index.bos[i - 1], &dev->bo_index.bos[i],
+              (dev->bo_index.count - i) * sizeof(struct kk_bo *));
+      dev->bo_index.count--;
+   }
+   bo->indexed = false;
+   simple_mtx_unlock(&dev->bo_index.lock);
