+         return;
+      }
+      dev->bo_index.bos = bos;
+      dev->bo_index.capacity = capacity;
+   }
+   uint32_t i = kk_bo_index_upper(dev, bo->gpu);
+   memmove(&dev->bo_index.bos[i + 1], &dev->bo_index.bos[i],
+           (dev->bo_index.count - i) * sizeof(struct kk_bo *));
