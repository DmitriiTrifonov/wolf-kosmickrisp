+/* TEMP diagnostics: count Metal object creation per bridge function */
+#include <stdio.h>
+#include <stdatomic.h>
+#include <time.h>
+static _Atomic long kk_bridge_counts[128];
+static const char *kk_bridge_names[128];
+static _Atomic long kk_bridge_total;
+void kk_bridge_note(int id, const char *name)
+{
+   kk_bridge_names[id] = name;
+   kk_bridge_counts[id]++;
+   if ((++kk_bridge_total % 3000) == 0) {
+      char line[2048]; int o = 0;
+      o += snprintf(line + o, sizeof(line) - o, "kkbridge2: t=%ld", (long)time(NULL));
+      for (int i = 0; i < 128 && o < (int)sizeof(line) - 64; i++)
+         if (kk_bridge_counts[i] > 100)
+            o += snprintf(line + o, sizeof(line) - o, " %d=%ld", i, (long)kk_bridge_counts[i]);
+      fprintf(stderr, "%s\n", line);
+   }
+}
+
+/* TEMP diagnostics: track every Metal object KosmicKrisp releases (via
+ * mtl_release) and whether Metal actually deallocates it (-dealloc hooked per
+ * class with a block IMP). Objects still alive after our release are retained
+ * by someone else. */
+#include <objc/runtime.h>
+#include <pthread.h>
+#define LT_CAP (1u << 22)
+#define LT_TOMB ((void *)1)
+#define LT_KINDS 64
+static pthread_mutex_t lt_mtx = PTHREAD_RECURSIVE_MUTEX_INITIALIZER;
+static struct { void *p; int kind; } lt[LT_CAP];
+static Class lt_cls[LT_KINDS];
+static int lt_nkinds;
+static long lt_released[LT_KINDS], lt_dealloced[LT_KINDS], lt_alive[LT_KINDS];
+static long lt_calls;
+
+static uint32_t lt_hash(void *p) { return (uint32_t)((((uintptr_t)p >> 4) * 0x9E3779B97F4A7C15ull) >> 40) & (LT_CAP - 1); }
+
+static void lt_note_dealloc(void *self)
+{
+   pthread_mutex_lock(&lt_mtx);
+   for (uint32_t h = lt_hash(self), n = 0; n < LT_CAP && lt[h].p; h = (h + 1) & (LT_CAP - 1), n++) {
+      if (lt[h].p == self) {
+         int k = lt[h].kind;
+         lt_dealloced[k]++; lt_alive[k]--;
+         lt[h].p = LT_TOMB;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&lt_mtx);
+}
+
+static int lt_kind(Class c)
+{
+   for (int i = 0; i < lt_nkinds; i++)
+      if (lt_cls[i] == c) return i;
+   if (lt_nkinds == LT_KINDS) return -1;
+   Method m = class_getInstanceMethod(c, @selector(dealloc));
+   IMP orig = method_getImplementation(m);
+   SEL sel = @selector(dealloc);
+   IMP hook = imp_implementationWithBlock(^(id self) {
+      lt_note_dealloc((void *)self);
+      ((void (*)(id, SEL))orig)(self, sel);
+   });
+   class_replaceMethod(c, sel, hook, method_getTypeEncoding(m));
+   lt_cls[lt_nkinds] = c;
+   return lt_nkinds++;
+}
+
+static void kk_leak_track(void *obj)
+{
+   if (!obj) return;
+   pthread_mutex_lock(&lt_mtx);
+   int k = lt_kind(object_getClass((id)obj));
+   if (k >= 0) {
+      uint32_t h = lt_hash(obj);
+      for (uint32_t n = 0; n < LT_CAP && lt[h].p && lt[h].p != LT_TOMB; n++)
+         h = (h + 1) & (LT_CAP - 1);
+      lt[h].p = obj; lt[h].kind = k;
+      lt_released[k]++; lt_alive[k]++;
+   }
+   if ((++lt_calls % 500000) == 0) {
+      for (int i = 0; i < lt_nkinds; i++)
+         if (lt_released[i] > 1000 || lt_alive[i] > 50)
+            fprintf(stderr, "kkleak: %-44s released=%ld dealloced=%ld alive=%ld\n", class_getName(lt_cls[i]),
+                    lt_released[i], lt_dealloced[i], lt_alive[i]);
+   }
+   pthread_mutex_unlock(&lt_mtx);
+}
